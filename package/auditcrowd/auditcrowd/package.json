{
  "name": "auditcrowd",
  "version": "0.1.0",
  "description": "AuditCrowd — verifiable assessment marketplace (ZeroBias custom app)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/app.git",
    "directory": "package/auditcrowd/auditcrowd/"
  },
  "scripts": {
    "dev": "node -e \"require('fs').copyFileSync('next.config.default.ts','next.config.ts')\" && next dev",
    "build:dev": "node -e \"require('fs').copyFileSync('next.config.dev.ts','next.config.ts')\" && next build",
    "build:qa": "node -e \"require('fs').copyFileSync('next.config.qa.ts','next.config.ts')\" && next build",
    "build:prod": "node -e \"require('fs').copyFileSync('next.config.prod.ts','next.config.ts')\" && next build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@auditlogic/module-github-github-client-ts": "^6.5.2",
    "@auditmation/zb-client-lib-js": "^0.5.13",
    "lucide-react": "^0.514.0",
    "material-symbols": "^0.31.4",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.1",
    "react-tabs": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "sass": "^1.89.0",
    "typescript": "^5"
  }
